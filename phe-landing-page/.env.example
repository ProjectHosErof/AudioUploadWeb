# Copy to .env and fill in. Every value here is public (safe in the browser bundle).

# Base URL of the deployed audio-upload-api Worker (no trailing slash).
# Leave unset to use the built-in default (the deployed Worker).
VITE_API_BASE_URL=https://audio-upload-api.dev-anthonyriad.workers.dev

# Cloudflare Turnstile SITE key that pairs with the Worker's TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=

# Supabase project URL and ANON (publishable) key — Dashboard > Settings > API.
# Use the `anon` key, NEVER the service_role key: the service key bypasses
# Row-Level Security and must stay server-side. RLS policies are what protect
# contributor data, so the anon key is safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
